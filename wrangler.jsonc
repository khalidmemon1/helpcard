// HelpCard's front door on Cloudflare (free). See edge/worker.js.
{
  "name": "helpcard",
  "main": "edge/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // the worker decides first: pages go to Cloud Run, the fallback is these files
    "run_worker_first": true
  },
  "routes": [{ "pattern": "helpcard.nuvolin.com", "custom_domain": true }],
  "vars": {
    // the Cloud Run URL, set after the first Cloud Run deploy ("" = Cloudflare serves everything)
    "ORIGIN": "https://helpcard-520349454001.us-central1.run.app"
  }
}
